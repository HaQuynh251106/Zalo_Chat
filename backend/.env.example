HTTP_ADDR=:8080

# Postgres
DATABASE_URL=postgres://zalo:zalo@localhost:5432/zalo?sslmode=disable

# Redis (presence cache, ratelimit) — optional, server runs without it
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=24h
JWT_REFRESH_TTL=720h

# CORS — comma list or "*"
ALLOWED_ORIGINS=*

# Media upload
UPLOAD_DIR=./uploads
# Để trống nếu phục vụ cùng host. Đặt "https://cdn.example.com" nếu serve CDN.
PUBLIC_BASE_URL=
